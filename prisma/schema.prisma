// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  name String

  email String @unique

  passwordHash String @map("password_hash")

  roles UserRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student?

  @@map("users")
}

model Role {
  id String @id @default(uuid())

  slug        String  @unique
  name        String
  description String?

  users UserRole[]

  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])

  role Role @relation(fields: [roleId], references: [id])

  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id String @id @default(uuid())

  slug        String  @unique
  name        String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role Role @relation(fields: [roleId], references: [id])

  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Course {
  id                        String   @id @default(uuid())
  institutionId             String  
  title                     String  
  description               String?  @db.Text 
  actionType                String   
  thematicArea              String  
  extensionLine             String  
  
  startDate                 DateTime 
  endDate                   DateTime 
  minParticipants           Int     
  maxParticipants           Int      
  workload                  Int      
  
  location                  String   
  funding                   String?  
  institutionalProgram      String?  
  offeringModel             String   
  targetMunicipalities      String   
  
  evaluationMethods         String   @db.Text 
  marketingMethods          String   @db.Text 
  activitiesPerformed       String   @db.Text 
  responsibleName           String   
  
  presentation              String   @db.Text 
  justification             String   @db.Text 
  targetAudience            String   
  generalObjective          String   @db.Text 
  specificObjective         String   @db.Text 
  methodology               String   @db.Text 
  coverImage                String?  

  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

 
  enrollments               Enrollment[]

  @@map("courses")
}

model Enrollment {
  id        String   @id @default(uuid())
  courseId  String
  studentId String   
  status    String   
  createdAt DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id]) 

  history   EnrollmentStatusHistory[]

  @@map("enrollments")
}

model Student {

  id        String @id @default(uuid())
  registry  String   @unique 
  createdAt DateTime @default(now())
  
  enrollments Enrollment[]
  userId      String @unique
  user         User @relation(fields: [userId], references: [id])
  @@map("students")
}

enum EnrollmentStatusEnum {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELED
}

model EnrollmentStatusHistory {
  id           String  @id @default(uuid())
  enrollmentId String  @map("enrollment_id")

  previousStatus EnrollmentStatusEnum? @map("previous_status")
  newStatus      EnrollmentStatusEnum  @map("new_status")

  changedBy    String  @map("changed_by") // User.id
  changeReason String? @db.Text @map("change_reason")

  createdAt DateTime @default(now()) @map("created_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("enrollment_status_history")
}